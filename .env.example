# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# 线上公开 OAuth client id，不是 secret。
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# ===== Docker 部署（docker-compose.yml 会从环境插值以下变量）=====
# 服务器访问令牌；未设置时除静态文件外的 API/WebSocket 对能访问端口的所有人开放。
# 生成方式自定（高熵随机串即可），设置后浏览器首次打开会弹出 Server Authentication 输入框。
ZCODE_SERVER_AUTH_TOKEN=
# Web Push（iOS/iPad 主屏幕 Web App 通知）。生成一次性 VAPID key：
#   corepack pnpm --filter @zcode/server exec web-push generateVAPIDKeys --json
# 详见 docs/PUSH_NOTIFICATION_SETUP.md。key 更换会使已有订阅失效，需要重新添加主屏幕。
ZCODE_PUSH_ENABLED=false
ZCODE_PUSH_VAPID_PUBLIC_KEY=
ZCODE_PUSH_VAPID_PRIVATE_KEY=
ZCODE_PUSH_VAPID_SUBJECT=
ZCODE_PUSH_SUBSCRIPTIONS_PATH=/data/.zcode/push-subscriptions.json
# 可选：推送 TTL 与超时（秒/毫秒），默认 300 / 10000。
ZCODE_PUSH_TTL_SECONDS=
ZCODE_PUSH_TIMEOUT_MS=
